{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup venv",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "start camera server (Windows)",
      "type": "shell",
      "command": "powershell.exe -NoProfile -Command \"Start-Process py -ArgumentList 'win_camera_server.py'\"",
      "detail": "Launches the frame server in a Windows console from WSL",
      "problemMatcher": []
    },
    {
      "label": "diagnose",
      "type": "shell",
      "command": ".venv/bin/python check_setup.py",
      "problemMatcher": []
    }
  ]
}
